load("@rules_cc//cc:cc_binary.bzl", "cc_binary")

package(default_visibility = ["//visibility:private"])

# Keep the first native Bazel gate focused on the declarative parser. It has no
# filesystem fixtures or process dependencies, so failures identify the CLI
# contract rather than the host environment.
cc_binary(
    name = "cli_parser_tests",
    srcs = ["CliParserTests.cpp"],
    deps = [
        "//Compiler/Cli/Arguments:arguments",
        "@catch2//:catch2_main",
    ],
)

cc_binary(
    name = "closure_pipeline_tests",
    srcs = ["ClosurePipelineTests.cpp"],
    deps = [
        "//Compiler/Codegen/Xmm:xmm",
        "//Compiler/Codegen/Xpp:xpp",
        "//Compiler/Core:core",
        "@catch2//:catch2_main",
    ],
)
