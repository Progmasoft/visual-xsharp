-- Imported by each local workspace. Do not use package *: Hackage packages
-- are not owned here. Guarded constructor-specific records are checked at
-- selector use (-Wincomplete-record-selectors), not banned as a data model.

package visual-xsharp-syntax
    ghc-options:
        -Wall
        -Wextra
        -Werror
        -Wcompat
        -Widentities
        -Wincomplete-patterns
        -Wincomplete-record-updates
        -Wincomplete-uni-patterns
        -Wincomplete-record-selectors
        -Wmissing-export-lists
        -Wmissing-home-modules
        -Wredundant-constraints
        -Wmissing-signatures
        -Wmissing-methods
        -Wmissing-fields
        -Wtype-defaults
        -Woverflowed-literals
        -Wempty-enumerations
        -Woverlapping-patterns
        -Wnoncanonical-monad-instances
        -Wnoncanonical-monoid-instances
        -Wredundant-bang-patterns
        -Wunbanged-strict-patterns
        -Wunused-imports
        -Wunused-local-binds
        -Wunused-top-binds
        -Wname-shadowing

