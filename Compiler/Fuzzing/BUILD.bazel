load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:private"])

cc_library(
    name = "wire_fuzz_harness",
    srcs = ["WireFuzz.cpp"],
    hdrs = ["WireFuzz.hpp"],
    deps = [
        "//Compiler/Codegen/Xmm:xmm",
        "//Compiler/Codegen/Xpp:xpp",
        "//Compiler/Core:core",
        "//Compiler/Headers/Visual/XSharp/Artifact:wire_support_api",
        "//Compiler/Headers/Visual/XSharp/Core:core",
        "//Compiler/Headers/Visual/XSharp/Core:coreprep_wire",
        "//Compiler/Headers/Visual/XSharp/Xmm:xmm",
        "//Compiler/Headers/Visual/XSharp/Xpp:xpp",
    ],
)

cc_binary(
    name = "wire_fuzz_smoke",
    srcs = ["WireFuzzSmoke.cpp"],
    deps = [":wire_fuzz_harness"],
)

# This binary has no project main: the libFuzzer runtime supplies it. Build it
# with the host's fuzz profile so all transitive project code is instrumented.
cc_binary(
    name = "wire_fuzzer",
    srcs = ["LibFuzzer.cpp"],
    deps = [":wire_fuzz_harness"],
)

# Structural comparison of two CorePrep lowerings. It has no frontend or LLVM
# dependency so its own contract can be tested without either.
cc_library(
    name = "coreprep_parity",
    srcs = ["CorePrepParity.cpp"],
    hdrs = ["CorePrepParity.hpp"],
    visibility = ["//Compiler/Fuzzing/Tests:__pkg__"],
    deps = ["//Compiler/Headers/Visual/XSharp/Core:core"],
)

cc_library(
    name = "source_fuzz_harness",
    srcs = ["SourceFuzz.cpp"],
    hdrs = ["SourceFuzz.hpp"],
    deps = [
        ":coreprep_parity",
        "//Compiler/Backend/LLVM:llvm_backend",
        "//Compiler/Cli/Commands:frontend",
        "//Compiler/Core:core",
        "//Compiler/Driver:pipeline",
        "//Compiler/Headers/Visual/XSharp/Core:core",
        "//Compiler/Headers/Visual/XSharp/Core:coreprep_wire",
        "//Compiler/Support:compiler_stack",
    ],
)

cc_binary(
    name = "source_fuzz_smoke",
    srcs = [
        "SourceFuzzSmoke.cpp",
    ],
    deps = [":source_fuzz_harness"],
)

# The three large tables of programs with hand-written results. A program of
# its own, so that it and the other smoke programs each run under one process
# watchdog.
cc_binary(
    name = "source_execution_smoke",
    srcs = [
        "BranchingExecutionCases.cpp",
        "BranchingExecutionCases.hpp",
        "ExecutionCases.cpp",
        "ExecutionCases.hpp",
        "ExpressionExecutionCases.cpp",
        "ExpressionExecutionCases.hpp",
        "Generated/LeavingCases.inc",
        "Generated/SelectionCases.inc",
        "LeavingExecutionCases.cpp",
        "LeavingExecutionCases.hpp",
        "SourceExecutionSmoke.cpp",
    ],
    deps = [":source_fuzz_harness"],
)

# The tables written by hand for single features: inferred return types,
# evaluation by need, enums and closures.
cc_binary(
    name = "source_feature_smoke",
    srcs = [
        "ExecutionCases.cpp",
        "ExecutionCases.hpp",
        "SourceFeatureSmoke.cpp",
    ],
    # The programs that create closures call the AARC runtime. The JIT
    # resolves a runtime symbol in the process that hosts it, so this program
    # links the runtime and exports its entry points.
    linkopts = select({
        "@platforms//os:windows": [
            "/EXPORT:vxs_aarc_abi_version",
            "/EXPORT:vxs_aarc_allocate",
            "/EXPORT:vxs_aarc_copy_unowned",
            "/EXPORT:vxs_aarc_copy_weak",
            "/EXPORT:vxs_aarc_is_exact_type",
            "/EXPORT:vxs_aarc_load_unowned",
            "/EXPORT:vxs_aarc_lock_weak",
            "/EXPORT:vxs_aarc_make_unowned",
            "/EXPORT:vxs_aarc_make_weak",
            "/EXPORT:vxs_aarc_release_strong",
            "/EXPORT:vxs_aarc_release_unowned",
            "/EXPORT:vxs_aarc_release_weak",
            "/EXPORT:vxs_aarc_retain_strong",
            "/EXPORT:vxs_aarc_string_literal",
        ],
        "@platforms//os:macos": [],
        "//conditions:default": ["-rdynamic"],
    }),
    deps = [
        ":source_fuzz_harness",
        "//Compiler/Headers/Visual/XSharp/Runtime:aarc_api",
        "//Compiler/Runtime/AARC:aarc",
    ],
)

# A measuring instrument, not a test: it compiles one source file on a stack
# of a chosen size and prints the stack the compilation committed.
cc_binary(
    name = "source_stack_probe",
    srcs = ["SourceStackProbe.cpp"],
    deps = [":source_fuzz_harness"],
)

cc_binary(
    name = "lexer_fuzzer",
    srcs = ["SourceLibFuzzer.cpp"],
    defines = ["VXS_SOURCE_FUZZ_STAGE=0"],
    deps = [":source_fuzz_harness"],
)

cc_binary(
    name = "parser_fuzzer",
    srcs = ["SourceLibFuzzer.cpp"],
    defines = ["VXS_SOURCE_FUZZ_STAGE=1"],
    deps = [":source_fuzz_harness"],
)

cc_binary(
    name = "source_llvm_fuzzer",
    srcs = ["SourceLibFuzzer.cpp"],
    defines = ["VXS_SOURCE_FUZZ_STAGE=2"],
    deps = [":source_fuzz_harness"],
)

cc_binary(
    name = "differential_fuzzer",
    srcs = ["SourceLibFuzzer.cpp"],
    defines = ["VXS_SOURCE_FUZZ_STAGE=3"],
    deps = [":source_fuzz_harness"],
)
