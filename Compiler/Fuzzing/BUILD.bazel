load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:private"])

cc_library(
    name = "wire_fuzz_harness",
    srcs = ["WireFuzz.cpp"],
    hdrs = ["WireFuzz.hpp"],
    deps = [
        "//Compiler/Codegen/Xmm:xmm",
        "//Compiler/Codegen/Xpp:xpp",
        "//Compiler/Core:core",
        "//Compiler/Headers/Visual/XSharp/Artifact:wire_support_api",
        "//Compiler/Headers/Visual/XSharp/Core:core",
        "//Compiler/Headers/Visual/XSharp/Core:coreprep_wire",
        "//Compiler/Headers/Visual/XSharp/Xmm:xmm",
        "//Compiler/Headers/Visual/XSharp/Xpp:xpp",
    ],
)

cc_binary(
    name = "wire_fuzz_smoke",
    srcs = ["WireFuzzSmoke.cpp"],
    deps = [":wire_fuzz_harness"],
)

# This binary has no project main: the libFuzzer runtime supplies it. Build it
# with the host's fuzz profile so all transitive project code is instrumented.
cc_binary(
    name = "wire_fuzzer",
    srcs = ["LibFuzzer.cpp"],
    deps = [":wire_fuzz_harness"],
)

cc_library(
    name = "source_fuzz_harness",
    srcs = ["SourceFuzz.cpp"],
    hdrs = ["SourceFuzz.hpp"],
    deps = [
        "//Compiler/Backend/LLVM:llvm_backend",
        "//Compiler/Cli/Commands:frontend",
        "//Compiler/Driver:pipeline",
    ],
)

cc_binary(
    name = "source_fuzz_smoke",
    srcs = ["SourceFuzzSmoke.cpp"],
    deps = [":source_fuzz_harness"],
)

cc_binary(
    name = "lexer_fuzzer",
    srcs = ["SourceLibFuzzer.cpp"],
    defines = ["VXS_SOURCE_FUZZ_STAGE=0"],
    deps = [":source_fuzz_harness"],
)

cc_binary(
    name = "parser_fuzzer",
    srcs = ["SourceLibFuzzer.cpp"],
    defines = ["VXS_SOURCE_FUZZ_STAGE=1"],
    deps = [":source_fuzz_harness"],
)

cc_binary(
    name = "source_llvm_fuzzer",
    srcs = ["SourceLibFuzzer.cpp"],
    defines = ["VXS_SOURCE_FUZZ_STAGE=2"],
    deps = [":source_fuzz_harness"],
)
