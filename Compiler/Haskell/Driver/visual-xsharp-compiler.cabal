name: visual-xsharp-compiler
version: 0.3.4
synopsis: Target-independent Visual X# compiler driver
license: MPL-2.0
author: Progmasoft
maintainer: support@progmasoft.com
build-type: Simple

library
    exposed-modules:
        Visual.XSharp.Compiler
        Visual.XSharp.Pipeline.Stage
    reexported-modules:
        visual-xsharp-syntax:Visual.XSharp.AST,
        visual-xsharp-syntax:Visual.XSharp.CharacterLiteral,
        visual-xsharp-syntax:Visual.XSharp.Diagnostic,
        visual-xsharp-syntax:Visual.XSharp.FloatingLiteral,
        visual-xsharp-syntax:Visual.XSharp.Lexer,
        visual-xsharp-syntax:Visual.XSharp.NumericLiteral,
        visual-xsharp-syntax:Visual.XSharp.Parser,
        visual-xsharp-frontend:Visual.XSharp.Frontend,
        visual-xsharp-frontend:Visual.XSharp.NumericSemantics,
        visual-xsharp-frontend:Visual.XSharp.BuiltinTypes,
        visual-xsharp-frontend:Visual.XSharp.ConstantEvaluation,
        visual-xsharp-frontend:Visual.XSharp.Closure.Analysis,
        visual-xsharp-frontend:Visual.XSharp.Resolver.NameResolution,
        visual-xsharp-frontend:Visual.XSharp.Resolver.Renamer,
        visual-xsharp-frontend:Visual.XSharp.SourceSet,
        visual-xsharp-frontend:Visual.XSharp.TypeChecker,
        visual-xsharp-core:Visual.XSharp.Core,
        visual-xsharp-core:Visual.XSharp.Core.Artifact,
        visual-xsharp-core:Visual.XSharp.Core.CorePrep,
        visual-xsharp-core:Visual.XSharp.Core.CorePrep.Verifier,
        visual-xsharp-core:Visual.XSharp.Core.CorePrep.Wire,
        visual-xsharp-core:Visual.XSharp.Core.CorePrep.Wire.Decode,
        visual-xsharp-core:Visual.XSharp.Core.CorePrep.Wire.Encode,
        visual-xsharp-core:Visual.XSharp.Core.CorePrep.Wire.Format,
        visual-xsharp-core:Visual.XSharp.Core.Optimizer,
        visual-xsharp-core:Visual.XSharp.Core.Scalar,
        visual-xsharp-core:Visual.XSharp.Core.Verifier,
        visual-xsharp-core:Visual.XSharp.Core.Wire,
        visual-xsharp-core:Visual.XSharp.Desugarer
    hs-source-dirs: src
    build-depends:
        base >=4.20 && <4.23,
        visual-xsharp-core,
        visual-xsharp-frontend,
        visual-xsharp-syntax
    default-language: GHC2021

executable vxs-frontend
    main-is: Main.hs
    hs-source-dirs: app
    build-depends:
        base >=4.20 && <4.23,
        bytestring >=0.12 && <0.14,
        text >=2.1 && <2.3,
        visual-xsharp-compiler
    default-language: GHC2021

test-suite visual-xsharp-compiler-tests
    type: exitcode-stdio-1.0
    main-is: Main.hs
    other-modules:
        ClosureTests
        CoreOptimizerTests
        CoreOptimizerSourceTests
        CoreVerifierTests
        NumericTests
        ScalarWireTests
        SourceSetTests
        VoidTests
    hs-source-dirs: test
    build-depends:
        base >=4.20 && <4.23,
        bytestring >=0.12 && <0.14,
        directory >=1.3 && <1.4,
        filepath >=1.5 && <1.6,
        visual-xsharp-compiler
    default-language: GHC2021
