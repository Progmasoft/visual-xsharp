load("@rules_cc//cc:cc_binary.bzl", "cc_binary")

package(default_visibility = ["//visibility:public"])

# Benchmarks are binaries rather than tests: ordinary correctness gates must
# stay deterministic and must not silently turn machine noise into failures.
cc_binary(
    name = "core_benches",
    srcs = ["CoreBenches.cpp"],
    deps = [
        "//Compiler/Core:core",
        "//Compiler/Headers/Visual/XSharp/Core:core",
        "//Compiler/Headers/Visual/XSharp/Core:coreprep",
        "//Compiler/Headers/Visual/XSharp/Core:coreprep_wire",
        "@google_benchmark//:benchmark_main",
    ],
)
