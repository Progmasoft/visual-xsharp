load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
package(default_visibility = ["//visibility:public"])

# vxs is the single public compiler command. Distribution bundles also place
# the private Haskell vxs-frontend companion beside it; native package seams do
# not become separately installed frontend or backend commands.
cc_binary(
    name = "vxs",
    srcs = ["Main.cpp"],
    deps = ["//Compiler/Cli/Commands:commands"],
)
