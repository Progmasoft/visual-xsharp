load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

# Visual/XSharp is the stable public include surface. Implementations live in
# the product-oriented Compiler/ tree and may evolve without renaming includes.
cc_library(
    name = "namespace",
    hdrs = ["Namespace.hpp"],
    strip_include_prefix = "/Compiler/Headers",
)

cc_library(
    name = "pipeline_api",
    hdrs = ["Pipeline.hpp"],
    strip_include_prefix = "/Compiler/Headers",
    deps = [
        "//Compiler/Headers/Visual/XSharp/Backend:llvm_api",
        "//Compiler/Headers/Visual/XSharp/Core:core",
        "//Compiler/Headers/Visual/XSharp/Core:coreprep",
        "//Compiler/Headers/Visual/XSharp/Core:coreprep_wire",
        "//Compiler/Headers/Visual/XSharp/Xmm:xmm",
        "//Compiler/Headers/Visual/XSharp/Xpp:xpp",
    ],
)
