cabal-version: 3.12
-- SPDX-FileCopyrightText: 2026 Progmasoft <support@progmasoft.com>
-- SPDX-License-Identifier: MPL-2.0 WITH AdditionRef-Progmasoft-Exception-1.1
name: visual-analyzer
version: 0.3.2
synopsis: Compiler-backed analysis model for Visual X# editor integrations
description:
    Provides compiler-backed analysis and a stdio JSON-RPC 2.0 language server
    for Visual X# editor integrations.
category: Development
license: MPL-2.0
author: Progmasoft
maintainer: support@progmasoft.com
build-type: Simple
data-files:
    Tests/Data/Valid.vxs
    Tests/Data/Broken.vxs

library
    exposed-modules:
        Visual.Analyzer
        Visual.Analyzer.Document
        Visual.Analyzer.Server
        Visual.Analyzer.Symbols
    hs-source-dirs: sources/main/haskell
    build-depends:
        base >=4.20 && <4.23,
        lsp >=2.8 && <2.9,
        lsp-types >=2.4 && <2.5,
        text >=2.0 && <2.2,
        transformers >=0.6 && <0.7,
        visual-xsharp-compiler >=0.5.0 && <0.6,
        visual-xsharp-syntax >=0.5.0 && <0.6
    default-language: GHC2024

executable visual-analyzer
    main-is: Main.hs
    hs-source-dirs: app
    build-depends:
        base >=4.20 && <4.23,
        visual-analyzer
    default-language: GHC2024

test-suite visual-analyzer-tests
    type: exitcode-stdio-1.0
    main-is: Main.hs
    other-modules: Paths_visual_analyzer
    autogen-modules: Paths_visual_analyzer
    hs-source-dirs: sources/test/haskell
    build-depends:
        base >=4.20 && <4.23,
        filepath,
        lsp-test >=0.18 && <0.19,
        lsp-types >=2.4 && <2.5,
        text >=2.0 && <2.2,
        transformers >=0.6 && <0.7,
        visual-analyzer,
        visual-xsharp-compiler
    build-tool-depends: visual-analyzer:visual-analyzer
    default-language: GHC2024
