<idea-plugin>
    <id>com.progmasoft.visual.xsharp.analyzer</id>
    <name>Visual X# Analyzer</name>
    <vendor email="support@progmasoft.com">Progmasoft</vendor>
    <description>Compiler-backed Visual X# diagnostics through the visual-analyzer LSP server.</description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.ultimate</depends>
    <depends>com.intellij.modules.lsp</depends>

    <extensions defaultExtensionNs="com.intellij">
        <platform.lsp.integrationProvider
            implementation="com.progmasoft.visual.xsharp.analyzer.intellij.VisualXsharpLspIntegrationProvider"/>
    </extensions>
</idea-plugin>
