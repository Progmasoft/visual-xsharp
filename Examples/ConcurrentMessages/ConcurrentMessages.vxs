namespace Examples.ConcurrentMessages;

using System.Threading.Sync;

public class ConcurrentMessages {
    public static void Main() {
        Mpsc.Channel<String> channel = Mpsc.Channel<String>();

        Thread.Spawn(\ -> {
            channel.Send("Lexer finished");
        });
        Thread.Spawn(\ -> {
            channel.Send("Parser finished");
        });

        String first = channel.Receive();
        String second = channel.Receive();
        Console.Println(first);
        Console.Println(second);
    }
}
