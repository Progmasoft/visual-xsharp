cabal-version: 3.12
-- SPDX-FileCopyrightText: 2026 Progmasoft <support@progmasoft.com>
-- SPDX-License-Identifier: MPL-2.0 WITH AdditionRef-Progmasoft-Exception-1.0
name: visual-linter
version: 0.1.0
synopsis: Compiler-backed static analysis for Visual X#
description:
    Provides compiler diagnostics, source hygiene checks, safe fixes, and the
    vlint command-line tool for Visual X# source files.
category: Development
license: MPL-2.0
author: Progmasoft
maintainer: support@progmasoft.com
build-type: Simple

library
    exposed-modules:
        Visual.Linter
    hs-source-dirs: sources/main/haskell
    build-depends:
        base >=4.20 && <4.23,
        visual-formatter >=0.1 && <0.2,
        visual-xsharp-compiler >=0.3.2 && <0.4
    default-language: GHC2021

executable vlint
    main-is: Visual/Linter/Main.hs
    other-modules:
        Visual.Linter
    hs-source-dirs: sources/main/haskell
    build-depends:
        base >=4.20 && <4.23,
        text >=2.1 && <2.3,
        visual-formatter,
        visual-linter,
        visual-xsharp-compiler
    default-language: GHC2021

test-suite visual-linter-tests
    type: exitcode-stdio-1.0
    main-is: Main.hs
    hs-source-dirs: sources/test/haskell
    build-depends:
        base >=4.20 && <4.23,
        visual-formatter,
        visual-linter,
        visual-xsharp-compiler
    default-language: GHC2021
