cabal-version: 3.12
name: visual-xsharp-compiler
version: 0.3.1
synopsis: Target-independent stages for the Visual X# compiler pipeline
description:
    Defines the stable stage vocabulary and emitted artifact extensions used by
    the renewed Visual X# compiler pipeline.
category: Development
license: MPL-2.0
author: Progmasoft
maintainer: support@xsharp-lang.xyz
build-type: Simple

library
    exposed-modules:
        Visual.XSharp.AST
        Visual.XSharp.Core
        Visual.XSharp.Core.Artifact
        Visual.XSharp.Core.CorePrep
        Visual.XSharp.Core.CorePrep.Verifier
        Visual.XSharp.Core.CorePrep.Wire
        Visual.XSharp.Core.CorePrep.Wire.Decode
        Visual.XSharp.Core.CorePrep.Wire.Encode
        Visual.XSharp.Core.CorePrep.Wire.Format
        Visual.XSharp.Core.Optimizer
        Visual.XSharp.Core.Verifier
        Visual.XSharp.Core.Wire
        Visual.XSharp.Compiler
        Visual.XSharp.Desugarer
        Visual.XSharp.Diagnostic
        Visual.XSharp.Lexer
        Visual.XSharp.Parser
        Visual.XSharp.Pipeline.Stage
        Visual.XSharp.Resolver.NameResolution
        Visual.XSharp.Resolver.Renamer
        Visual.XSharp.SourceSet
        Visual.XSharp.TypeChecker
    hs-source-dirs: src
    build-depends:
        base >=4.20 && <4.23,
        bytestring >=0.12 && <0.14,
        containers >=0.7 && <0.9,
        directory >=1.3 && <1.4,
        filepath >=1.5 && <1.6,
        text >=2.1 && <2.3
    default-language: GHC2021

executable vxs-frontend
    main-is: Main.hs
    hs-source-dirs: app
    build-depends:
        base >=4.20 && <4.23,
        visual-xsharp-compiler
    default-language: GHC2021

test-suite compiler-layer-tests
    type: exitcode-stdio-1.0
    main-is: Main.hs
    hs-source-dirs: test
    other-modules:
        SourceSetTests
    build-depends:
        base >=4.20 && <4.23,
        bytestring >=0.12 && <0.14,
        directory >=1.3 && <1.4,
        filepath >=1.5 && <1.6,
        visual-xsharp-compiler
    default-language: GHC2021
