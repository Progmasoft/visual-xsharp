packages:
    haskell/visual-xsharp-compiler/visual-xsharp-compiler.cabal
    ../VisualAnalyzer/visual-analyzer.cabal
    ../VisualFormatter/visual-formatter.cabal
    ../VisualLinter/visual-linter.cabal

with-compiler: ghc
optimization: 2
tests: True
benchmarks: False
documentation: False
write-ghc-environment-files: never

package *
    ghc-options:
        -Wall
        -Wcompat
        -Widentities
        -Wincomplete-record-updates
        -Wincomplete-uni-patterns
        -Wmissing-export-lists
        -Wmissing-home-modules
        -Wpartial-fields
        -Wredundant-constraints
