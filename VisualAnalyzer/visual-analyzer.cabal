cabal-version: 3.12
name: visual-analyzer
version: 0.3.2
synopsis: Compiler-backed analysis model for Visual X# editor integrations
description:
    Provides the document analysis and protocol diagnostic boundary shared by
    Visual X# editor integrations without introducing a standalone executable.
category: Development
license: MPL-2.0
author: Progmasoft
maintainer: support@xsharp-lang.xyz
build-type: Simple

library
    exposed-modules:
        Visual.Analyzer
    hs-source-dirs: sources/main/haskell
    build-depends:
        base >=4.20 && <4.23,
        visual-xsharp-compiler >=0.3.2 && <0.4
    default-language: GHC2021

test-suite visual-analyzer-tests
    type: exitcode-stdio-1.0
    main-is: Main.hs
    hs-source-dirs: sources/test/haskell
    build-depends:
        base >=4.20 && <4.23,
        visual-analyzer,
        visual-xsharp-compiler
    default-language: GHC2021
