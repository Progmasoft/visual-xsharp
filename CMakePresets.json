{
  "version": 9,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 31,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "clangcl-debug",
      "displayName": "ClangCL Debug (Windows x64)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/clangcl-debug",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl",
        "CMAKE_RC_COMPILER": "rc",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "XS_ENABLE_PROJECTS": "xs",
        "XS_ENABLE_RUNTIMES": "xsrt"
      }
    },
    {
      "name": "clangcl-sanitize",
      "displayName": "ClangCL AddressSanitizer (Windows x64)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/clangcl-sanitize",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl",
        "CMAKE_RC_COMPILER": "rc",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "XS_ENABLE_PROJECTS": "xs",
        "XS_ENABLE_RUNTIMES": "xsrt",
        "XS_ENABLE_SANITIZERS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "clangcl-debug",
      "configurePreset": "clangcl-debug"
    },
    {
      "name": "clangcl-sanitize",
      "configurePreset": "clangcl-sanitize"
    }
  ],
  "testPresets": [
    {
      "name": "clangcl-debug",
      "configurePreset": "clangcl-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "clangcl-sanitize",
      "configurePreset": "clangcl-sanitize",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
